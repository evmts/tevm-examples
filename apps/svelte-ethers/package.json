{
	"name": "@tevm/example-svelte-ethers",
	"version": "0.1.3",
	"private": false,
	"description": "SvelteKit example using the Tevm Ethers adapter and Solidity imports",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-examples.git",
		"directory": "apps/svelte-ethers"
	},
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-check --tsconfig ./jsconfig.json --watch",
		"dev": "vite dev",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "pnpm run check",
		"test:e2e": "node ../../scripts/smoke-http.mjs --marker \"Welcome to SvelteKit\" --marker \"totalSupply():\" -- pnpm exec vite preview --host 127.0.0.1 --port {port} --strictPort"
	},
	"dependencies": {
		"@tevm/contract": "^1.0.0-next.149",
		"@tevm/ethers": "^1.0.0-next.148",
		"ethers": "^6.16.0",
		"viem": "~2.37.13"
	},
	"peerDependencies": {
		"tevm": "^1.0.0-next.149"
	},
	"devDependencies": {
		"@openzeppelin/contracts": "^5.6.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tevm/ts-plugin": "^1.0.0-next.148",
		"@tevm/vite-plugin": "^1.0.0-next.148",
		"rollup": "^4.62.3",
		"solc": "0.8.35",
		"svelte": "^5.55.8",
		"svelte-check": "^4.4.8",
		"tevm": "^1.0.0-next.149",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
