{
  "name": "@tevm/example-mud",
  "version": "0.0.0",
  "private": false,
  "description": "MUD application example for Tevm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evmts/tevm-examples.git",
    "directory": "apps/mud"
  },
  "scripts": {
    "build": "pnpm --filter contracts run build && pnpm --filter client run build",
    "dev": "mprocs",
    "dev:client": "pnpm --filter 'client' run dev",
    "dev:contracts": "pnpm --filter 'contracts' dev",
    "foundry:up": "curl -L https://foundry.paradigm.xyz | bash && bash $HOME/.foundry/bin/foundryup",
    "mud:up": "pnpm mud set-version --tag main && pnpm install",
    "test": "pnpm --filter contracts run test && pnpm --filter client run test",
    "typecheck": "pnpm --filter contracts run typecheck && pnpm --filter client run typecheck"
  },
  "devDependencies": {
    "@latticexyz/cli": "2.2.23",
    "@latticexyz/common": "2.2.23",
    "@latticexyz/explorer": "2.2.23",
    "@latticexyz/store-indexer": "2.2.23",
    "@types/debug": "4.1.13",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "mprocs": "^0.9.2",
    "shx": "^0.4.0",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
